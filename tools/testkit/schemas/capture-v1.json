{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://bit-physics.local/schemas/capture-v1.json",
  "title": "Bit-Physics Capture Manifest",
  "description": "Canonical capture-manifest schema (spec § 2.7). schema_version is initially 1.0.0; bumps governed by spec § 2.12 (Phase 4 WU-A only).",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "sim",
    "stack",
    "config",
    "run",
    "payload",
    "determinism"
  ],
  "properties": {
    "schema_version": {
      "type": "string",
      "pattern": "^\\d+\\.\\d+\\.\\d+$",
      "description": "Semantic version of this capture schema."
    },
    "sim": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "category", "variant"],
      "properties": {
        "name":     { "type": "string", "minLength": 1 },
        "category": { "type": "string", "minLength": 1 },
        "variant":  { "type": "string", "minLength": 1 }
      }
    },
    "stack": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "version", "build_id"],
      "properties": {
        "name":     { "type": "string", "minLength": 1 },
        "version":  { "type": "string", "minLength": 1 },
        "build_id": { "type": "string", "minLength": 1 }
      }
    },
    "config": {
      "type": "object",
      "additionalProperties": false,
      "required": ["tier", "dims", "dtype", "seed", "params"],
      "properties": {
        "tier":  { "type": "string", "minLength": 1 },
        "dims":  {
          "type": "array",
          "items": { "type": "integer", "minimum": 1 },
          "minItems": 1
        },
        "dtype": { "type": "string", "enum": ["f32", "f64"] },
        "seed":  { "type": "integer" },
        "params": { "type": "object" }
      }
    },
    "run": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "step_count", "capture_interval", "wall_clock_seconds", "start_utc"
      ],
      "properties": {
        "step_count":         { "type": "integer", "minimum": 0 },
        "capture_interval":   { "type": "integer", "minimum": 1 },
        "wall_clock_seconds": { "type": "number",  "minimum": 0 },
        "start_utc":          { "type": "string", "minLength": 1 }
      }
    },
    "payload": {
      "type": "object",
      "additionalProperties": false,
      "required": ["format", "path", "checksum"],
      "properties": {
        "format":   { "type": "string", "enum": ["hdf5"] },
        "path":     { "type": "string", "minLength": 1 },
        "checksum": {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$"
        }
      }
    },
    "determinism": {
      "type": "object",
      "additionalProperties": false,
      "required": ["claimed", "atomic_ops", "subgroup_ops"],
      "properties": {
        "claimed": {
          "type": "string",
          "enum": ["bit-exact-same-hw", "epsilon", "non-deterministic"]
        },
        "atomic_ops":   { "type": "boolean" },
        "subgroup_ops": { "type": "boolean" }
      }
    }
  }
}
