{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://bit-physics.local/schemas/tolerance-v1.json",
  "title": "Equivalence tolerance table",
  "description": "Cross-stack equivalence tolerance table (spec § 2.6). Per-category defaults + optional per-sim overrides.",
  "type": "object",
  "additionalProperties": false,
  "required": ["defaults"],
  "properties": {
    "defaults": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "additionalProperties": false,
        "required": ["relative", "absolute"],
        "properties": {
          "relative": { "type": "number", "minimum": 0.0 },
          "absolute": { "type": "number", "minimum": 0.0 }
        }
      },
      "minProperties": 1
    },
    "overrides": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "additionalProperties": false,
        "required": ["category"],
        "properties": {
          "category": { "type": "string", "minLength": 1 },
          "relative": { "type": "number", "minimum": 0.0 },
          "absolute": { "type": "number", "minimum": 0.0 }
        }
      }
    }
  }
}
