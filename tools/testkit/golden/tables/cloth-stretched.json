  "config": {
    "gap": 10.5,
    "iterations": 80,
    "nx": 8,
    "ny": 1,
    "spacing": 1.0,
    "steps": 2000,
    "stretch_compliance": 1e-07,
    "uniform_spacing": 1.5,
    "velocity_damping": 0.2
  },
  "derivation": {
    "doc": "tools/testkit/golden/derivations/cloth-catenary-limit.md"
