#version 450
// Clebsch-PFM pairwise wave-function inner products — Stack-C f64 (NoContraction).
//
// Paper Eqs. 19/23 split (probe § 5 / spec § 6 execution posture): GLSL exposes no f64
// transcendentals, so this kernel computes the COMPLEX inner product per sample pair
//   z[i] = <A[i], B[i]>_C = conj(a1)b1 + conj(a2)b2
// in pure f64 arithmetic; the host applies u_f = (hbar/dx_s)*atan2(Im z, Re z). The
// pairs are MAC-face sample spinors (the Eq.-23 enhanced-conversion points f1/f2,
// P2G-evaluated host-side) or grid-adjacent cells (Eq. 19 at init/standardization).
// Element-wise, no atomics; `precise` -> NoContraction.
//
// Layout: A/B are 4 doubles per item (Re1, Im1, Re2, Im2); Z is 2 doubles per item.
#extension GL_ARB_gpu_shader_fp64 : require

layout(local_size_x = 64) in;
layout(std430, binding = 0) readonly  buffer Abuf { double a[]; };
layout(std430, binding = 1) readonly  buffer Bbuf { double b[]; };
layout(std430, binding = 2) writeonly buffer Zbuf { double z[]; };
layout(push_constant) uniform Params {
    uint count;
} p;

void main() {
    uint item = gl_GlobalInvocationID.x;
    if (item >= p.count) return;

    double a1r = a[4u * item + 0u], a1i = a[4u * item + 1u];
    double a2r = a[4u * item + 2u], a2i = a[4u * item + 3u];
    double b1r = b[4u * item + 0u], b1i = b[4u * item + 1u];
    double b2r = b[4u * item + 2u], b2i = b[4u * item + 3u];
    // conj(a)*b: (ar - i*ai)(br + i*bi) = (ar*br + ai*bi) + i(ar*bi - ai*br)
    precise double re = ((a1r * b1r + a1i * b1i) + (a2r * b2r + a2i * b2i));
    precise double im = ((a1r * b1i - a1i * b1r) + (a2r * b2i - a2i * b2r));
    z[2u * item + 0u] = re;
    z[2u * item + 1u] = im;
}
