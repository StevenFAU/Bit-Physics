#version 450
// Determinism-baseline reproduction shader (Stage 1a; gate C-3).
//
// Byte-for-byte identical compute to the Stage-0 ephemeral probe
// (docs/_audits/phase-2/sub-phase-common-cpp-bootstrap/stage-0-evidence/
// determinism-probe.comp). Building this through the PRODUCTION substrate and
// reading back the buffer MUST reproduce the C-stack determinism baseline
// digest a7f85bd43e5cd9c64a0882584c4c73faa67901c261d937c6394bc3cce2844f05
// (§ L.7 O-2 ephemeral→production chain, checkpoint-2).
//
// No atomics, no cross-invocation reduction: per-element FP only, so the result
// is bit-identical regardless of lavapipe thread count (S0-CPPB3).
layout(local_size_x = 64) in;
layout(std430, binding = 0) buffer Buf { float data[]; };
void main() {
    uint i = gl_GlobalInvocationID.x;
    if (i >= data.length()) return;
    float x = float(i) * 0.01;
    // deterministic element-wise FP (no atomics, no cross-invocation reduction)
    float y = x * x * 0.5 + x * 0.25 + 0.125;
    data[i] = y;
}
