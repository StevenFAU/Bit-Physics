#version 450
layout(local_size_x = 64) in;
layout(std430, binding = 0) buffer Buf { float data[]; };
void main() {
    uint i = gl_GlobalInvocationID.x;
    if (i >= data.length()) return;
    float x = float(i) * 0.01;
    // deterministic element-wise FP (no atomics, no cross-invocation reduction)
    float y = x * x * 0.5 + x * 0.25 + 0.125;
    data[i] = y;
}
