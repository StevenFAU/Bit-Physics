# Text normalization (LF for tracked text)
* text=auto eol=lf

# Explicit binaries — do not normalize, do not diff as text
*.h5     binary
*.hdf5   binary
*.png    binary
*.jpg    binary
*.jpeg   binary
*.pdf    binary
*.ico    binary
*.zip    binary
*.tar    binary
*.tgz    binary
*.gz     binary
*.bin    binary
*.npy    binary
*.npz    binary
# Source / data file types
*.py     text diff=python
*.md     text
*.toml   text
*.yaml   text
*.yml    text
*.json   text
*.cff    text
*.ts     text
*.tsx    text
*.js     text
*.mjs    text
*.cjs    text
*.cpp    text
*.hpp    text
*.h      text
*.glsl   text
*.wgsl   text
*.sh     text eol=lf
captures/**/*.h5 filter=lfs diff=lfs merge=lfs -text
# Schema-corpus HDF5 fixtures route through LFS as of
# sub-phase-lattice-boltzmann-d3q19-stack-d Stage 2 (N1 resolution): the LBM
# Poiseuille canonical (~202 MB) exceeds GitHub's 100 MB hard push limit, which
# the prior non-LFS legacy-captures convention could not carry. Applies going
# forward only; the existing non-LFS sph-water-stack-d (61 MB) + smaller phase-0/2
# entries remain as committed historical blobs (not retroactively re-tagged).
tests/fixtures/legacy-captures/**/*.h5 filter=lfs diff=lfs merge=lfs -text

# Phase-3 task-6 neural-ca: trained checkpoint + converted WGSL artifact (LFS per
# charter §3 F). Small now (33 KB) but routed through LFS for forward consistency.
tools/testkit/golden/checkpoints/**/*.safetensors filter=lfs diff=lfs merge=lfs -text
tools/testkit/golden/checkpoints/**/*.bin filter=lfs diff=lfs merge=lfs -text

# Phase-3 task-8 3dgs-mpm: committed golden render PNGs (the Prong-2 render-similarity
# targets). Small for the synthetic scene (D-SCENE) but routed through LFS per charter §Q
# (the phase's heaviest media footprint) + forward consistency.
tools/testkit/golden/renders/**/*.png filter=lfs diff=lfs merge=lfs -text
*.webm   binary
